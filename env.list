# Managed single-vehicle ArduPilot runtime. CLI scalar options override env.
# Validate before launch: run-sitl.sh --validate
# Inspect the resolved configuration: run-sitl.sh --print-effective-config

INSTANCE=0
SYSID=1
VEHICLE=ArduCopter
FRAME=quad
LAT=37.1971467
LON=-80.5780381
ALT=618
DIR=55
# ArduPilot sim_vehicle releases require a positive integer speed multiplier.
SPEEDUP=1

# Read-only input bundle. Relative artifact paths resolve here.
# vehicleinfo.json is discovered automatically; upstream files are never replaced.
SITL_CONFIG_DIR=/configs
# VEHICLEINFO_JSON=vehicleinfo.json
# MODEL=quad:/configs/my_quad.json

# Parameter order (last wins): native defaults, bundle files, PARAM_FILES,
# PARAM_FILE, then repeated CLI --add-param-file options.
# PARAM_FILES=["base.parm","controller.parm"]
# PARAM_FILE=overrides.parm

# Bundle scripts/ is restaged on every launch. This explicit script overrides
# a bundled script with the same basename. User scripts still need SCR_ENABLE=1.
# LUA_SCRIPT=initial-state.lua

# Mission/fence/rally are fully parsed before launch, then uploaded via MAVLink.
# Mission loading does NOT require Lua or SCR_ENABLE. Empty selected plans clear
# their respective plan type; omitted plans are not uploaded or cleared.
# MISSION_FILE=missions/simple-copter.waypoints
# FENCE_FILE=fences/simple-polygon.json
# RALLY_FILE=rally/recovery-points.json

# Owned run directory: must be empty or previously initialized by this runner.
# Contains work/, history/, effective-config.json, and status.json.
# --use-dir is the CLI equivalent of SITL_RUN_DIR.
# Default: /tmp/ardupilot-sitl/instance_<INSTANCE>
# SITL_RUN_DIR=/home/ardupilot/runs
# ARTIFACTS_DIR=/artifacts

# fresh archives the previous work/ before starting; resume preserves vehicle
# state but restages scripts and uploads explicitly selected plans again.
SITL_STATE=fresh
SITL_STOP_TIMEOUT=10

# Readiness means the expected autopilot heartbeat and all requested plan ACKs
# were received, and the vehicle process is still running. It is NOT an arming,
# GPS, EKF, or user-Lua-completion check. Timeout covers the entire initialization.
PLAN_UPLOAD_TIMEOUT=60

# 1: direct single-client TCP; do not connect a GCS before readiness.
# 0: MAVProxy fan-out; initializer uses private TCP port 20000 + INSTANCE.
NO_MAVPROXY=1
# PROXY requires NO_MAVPROXY=0; accepts --out, --logfile, --streamrate only.
# PROXY=--out=udp:host.docker.internal:14550
# Optional override, checked against SYSID/component 1:
# PLAN_UPLOAD_MASTER=tcp:127.0.0.1:20000

# Advanced/debug use: invoke upstream sim_vehicle.py explicitly when you need
# unsupported flags (UDP transport, debuggers, multi-vehicle/peripheral launch).
# Such runs bypass managed staging, supervision, and readiness.
# ARDUPILOT_ROOT=/home/ardupilot/ardupilot
